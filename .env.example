# Скопируйте этот файл в .env и заполните реальными значениями.
# .env добавлен в .gitignore — не коммитьте его.

# Django SECRET_KEY. Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Отдельный ключ шифрования для сохранённых сервисных паролей (apps.security).
# НЕ путать с SECRET_KEY — это независимый секрет. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me

# True только для локальной разработки, в проде всегда False.
DEBUG=True

# ──────────────────────────────────────────────────────────────
# Нужны только для DJANGO_SETTINGS_MODULE=config.settings.prod
# ──────────────────────────────────────────────────────────────

# Реальные домены через запятую, без схемы.
ALLOWED_HOSTS=example.com,www.example.com

# Те же домены, но с https:// — нужно для CSRF при отправке форм.
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# PostgreSQL.
DB_NAME=studentassistent
DB_USER=studentassistent
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Redis — channel layer для чата (без него в проде на >1 worker сообщения
# не будут доходить до всех подключённых клиентов). Без пароля:
#   REDIS_URL=redis://localhost:6379
REDIS_URL=redis://localhost:6379
